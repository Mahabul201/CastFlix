# Koyeb / Local Environment Variables
PORT=8000
NODE_ENV=production

# MongoDB Atlas or local connection string
# Example: mongodb+srv://username:password@cluster0.mongodb.net/urlstream?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017/urlstream

# Password used to log into the Admin Web Panel (/admin)
ADMIN_PASSWORD=your_secure_admin_password_here

# Secret used for signing JWT authentication tokens
JWT_SECRET=super_secret_jwt_key_url_stream_2026
